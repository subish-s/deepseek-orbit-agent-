# DeepSeek Credentials
EMAIL=your_email@example.com
PASSWORD=your_deepseek_password
BASE_URL=https://chat.deepseek.com/

# API Security
API_BEARER_TOKEN=replace_with_a_strong_random_token

# Agent Sandbox Root (defaults to ~/Documents/Project if unset)
AGENT_ROOT=/path/to/your/workspace

# Dashboard / Admin Settings (optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_admin_password
ADMIN_PATH=/admin
REQUIRE_USER_AUTH=false
USER_USERNAME=
USER_PASSWORD=
BACKEND_URL=http://127.0.0.1:8000
