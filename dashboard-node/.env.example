# === Backend Connection (the real Python automation server) ===
BACKEND_URL=http://127.0.0.1:8000/chat
API_BEARER_TOKEN=your_bearer_token_here

# === Optional User Login for the Chat UI ===
REQUIRE_USER_AUTH=false
USER_USERNAME=user
USER_PASSWORD=

# === Admin Panel (optional) ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PATH=/admin

# NOTE:
# Best way: Run `npm run setup` after `npm install`.
# This will automatically create a .env.local file for you (recommended).
#
# .env.local is gitignored and the perfect place for secrets.
#
# Example .env.local:
# BACKEND_URL=http://127.0.0.1:8000/chat
# API_BEARER_TOKEN=413eff4ff6b33d9f7ac0c4e759255251f06ebc56fef1742f51e05bcf77b96ab00dc577d194dcd343b44f429f5bd5f5895a032111f5009aa14cce223a606e8604
